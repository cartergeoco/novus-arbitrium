# Leave both unset for local play. The server then uses http://127.0.0.1:11434 and sends no credential.
# On the deployed host, set the private HTTPS origin and the same token the home gateway expects.
# Do not put the token in the URL. Do not expose port 11434.
OLLAMA_BASE_URL=
OLLAMA_TOKEN=
# A separate, randomly generated 32+ character key is required to use Ollama on a public deployment.
# Enter its value in Settings -> API in your browser. Never reuse OLLAMA_TOKEN here.
OLLAMA_CLIENT_KEY=

# Used only by scripts/ollama-gateway.mjs on the computer running Ollama.
OLLAMA_GATEWAY_PORT=11435
OLLAMA_UPSTREAM=http://127.0.0.1:11434

# Supabase accounts. The Vercel project integration provides these in production.
# SUPABASE_SERVICE_ROLE_KEY stays on the server and is never sent to the browser.
# Campaign saves are private files in the "campaigns" storage bucket, five per account.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
