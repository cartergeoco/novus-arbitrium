# Leave both unset for local play. The server then uses http://127.0.0.1:11434 and sends no credential.
# On the deployed host, set the private HTTPS origin and the same token the home gateway expects.
# Do not put the token in the URL. Do not expose port 11434.
OLLAMA_BASE_URL=
OLLAMA_TOKEN=
# A separate, randomly generated 32+ character key is required to use Ollama on a public deployment.
# Enter its value in Settings -> API in your browser. Never reuse OLLAMA_TOKEN here.
OLLAMA_CLIENT_KEY=

# Used only by scripts/ollama-gateway.mjs on the computer running Ollama.
OLLAMA_GATEWAY_PORT=11435
OLLAMA_UPSTREAM=http://127.0.0.1:11434

# Supabase project: Project Settings -> API Keys. Add these to the hosting secret settings.
# No NEXT_PUBLIC_ variables are needed; the browser only calls this site's API.
# The publishable key identifies the project; the secret key is server-only and must never be exposed.
# The old SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY names still work for existing deployments.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (free Invisible widget). Add the live hostname in its widget settings.
# In production all three values are required for sign-in and AI requests.
# The site key is public; keep the other two server-only and generate the signing secret independently.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BROWSER_CHECK_SECRET=
